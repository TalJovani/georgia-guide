# Copy this file to .env and fill in the values.

# Local development database (Docker container from ../docker-compose.yml)
DATABASE_URL="postgresql://georgia:georgia_dev_password@localhost:5432/georgia_guide?schema=public"

# Secret key used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# AI summary of trip requests (optional: without a key the app works, just with no summary).
# Pick one of the two options below.

# Option 1: Anthropic directly (console.anthropic.com)
ANTHROPIC_API_KEY=""

# Option 2: OpenRouter (openrouter.ai/keys). Leave ANTHROPIC_API_KEY empty.
# ANTHROPIC_BASE_URL="https://openrouter.ai/api"
# ANTHROPIC_AUTH_TOKEN=""
# AI_MODEL="anthropic/claude-opus-5.5"

# Web Push notifications (optional: without them the account page falls back to in-page
# notifications). Generate a key pair with:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A way to reach you, for the push services: "mailto:you@example.com"
VAPID_SUBJECT=""
