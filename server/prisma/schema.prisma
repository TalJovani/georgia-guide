// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TRAVELER
  GUIDE
}

enum TripStatus {
  NEW
  ITINERARY_SENT
  IN_REVISION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum KosherPreference {
  NONE
  KOSHER_STYLE
  KOSHER
  MEHADRIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole @default(TRAVELER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sentMessages      Message[]
  reviews           Review[]
  pushSubscriptions PushSubscription[]
  tripRequests      TripRequest[]      @relation("TravelerTrips")
  guidedRequests    TripRequest[]      @relation("GuideTrips")
}

model TripRequest {
  id               String           @id @default(uuid())
  startDate        DateTime         @db.Date
  endDate          DateTime         @db.Date
  travelersCount   Int
  /// Budget range for the whole group (not per person), in `currency`.
  budgetMin        Int?
  budgetMax        Int?
  currency         String           @default("ILS")
  kosher           KosherPreference @default(NONE)
  needsFlights     Boolean          @default(false)
  needsHotels      Boolean          @default(false)
  needsCarRental   Boolean          @default(false)
  /// Full package: flights, lodging, attractions and entertainment.
  /// When true, needsFlights and needsHotels are true as well.
  needsFullPackage Boolean          @default(false)
  description      String
  status           TripStatus       @default(NEW)
  /// When the trip was cancelled. Compared with startDate for the refund policy.
  cancelledAt      DateTime?
  /// What the traveler asked to change, the last time they requested changes.
  revisionNote     String?
  /// AI summary of the request for the guide: short Hebrew tags, and one idea for the route.
  /// Empty / null until the summary has been made (or if making it failed).
  aiTags           String[]         @default([])
  aiSuggestion     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  travelerId String
  traveler   User    @relation("TravelerTrips", fields: [travelerId], references: [id])
  guideId    String?
  guide      User?   @relation("GuideTrips", fields: [guideId], references: [id])

  messages      Message[]
  review        Review?
  itineraryDays ItineraryDay[]

  @@index([travelerId])
  @@index([guideId])
  @@index([status])
}

/// One day of the itinerary the guide builds for a trip request.
model ItineraryDay {
  id        String   @id @default(uuid())
  /// 1 = the trip's first day (startDate).
  dayNumber Int
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripRequestId String
  tripRequest   TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)

  activities ItineraryActivity[]

  @@unique([tripRequestId, dayNumber])
}

/// One time slot in an itinerary day, like an event in a calendar.
model ItineraryActivity {
  id        String  @id @default(uuid())
  /// "HH:MM" in 24-hour time. Zero-padded, so sorting the text sorts by time.
  startTime String
  endTime   String
  title     String
  details   String?

  dayId String
  day   ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

/// A chat message between the traveler and the guide of a trip.
/// The chat is locked (read-only) once the trip is COMPLETED or CANCELLED.
model Message {
  id        String    @id @default(uuid())
  body      String
  createdAt DateTime  @default(now())
  /// When the other side opened the chat. Null = not read yet.
  readAt    DateTime?

  tripRequestId String
  tripRequest   TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  @@index([tripRequestId, createdAt])
}

/// A public review by a traveler: about one trip (at most one per trip), or about the site in general.
/// Shown to everyone, with the author's full name, unless the guide hid it.
model Review {
  id        String    @id @default(uuid())
  /// 1 to 5 stars. Checked by the server (Prisma has no range check).
  rating    Int
  text      String?
  createdAt DateTime  @default(now())
  /// When the guide hid it as offensive. Null = shown.
  hiddenAt  DateTime?

  authorId String
  /// Deleting the account deletes the reviews too, so the name next to them never outlives the account.
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// Null = a general review, not about a specific trip.
  tripRequestId String?      @unique
  tripRequest   TripRequest? @relation(fields: [tripRequestId], references: [id])

  @@index([createdAt])
}

/// One browser where a user turned on push notifications. The browser's push service gives
/// the endpoint and keys; the server sends each new chat message there, encrypted.
model PushSubscription {
  id        String   @id @default(uuid())
  /// The address at the browser's push service. Unique: one row per browser.
  endpoint  String   @unique
  /// The browser's keys for encrypting what we send it.
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
